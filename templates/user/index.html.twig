{% extends 'base.html.twig' %}

{% block title %}Users List{% endblock %}

{% block body %}
    <div class="container mt-5 mb-5">
        <div class="section-title text-center mb-4">
            <h2>Users List</h2>
        </div>

        <a href="{{ path('app_user_new') }}" class="btn btn-primary mb-4">Create New User</a>

        <table class="table table-bordered table-striped table-hover">
            <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-info btn-sm">View</a>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">Edit</a>
                        <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">No users found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <style>
        .section-title h2 {
            font-size: 2rem;
            color: #555;
        }

        .btn {
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            opacity: 0.8;
        }

        /* Custom Table Styling: Remove background color */
        .table {
            background-color: transparent;
            color: #333;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f9f9f9; /* Slightly light gray background for odd rows */
        }

        .table-hover tbody tr:hover {
            background-color: #f1f1f1; /* Light gray on hover */
        }
    </style>

{% endblock %}
