{% extends 'base.html.twig' %}

{% block title %}Add Menu{% endblock %}

{% block body %}
    <div class="container" data-aos-delay="100" style="margin-top: 150px; margin-bottom: 50px;">

        <div class="section-title ">
            <h2>Menu</h2>
            <p>Add new menu</p>
        </div>
        <div class="branding d-flex align-items-cente" style="margin-bottom: 20px">
            <div class="container position-relative d-flex align-items-center justify-content-between">
                <a href="{{ path('menu_list') }}" class="btn btn-warning">Check List</a>
            </div>
        </div>
        {{ form_start(form, {'attr': {'class': 'php-email-form'}}) }}

        <div class="row gy-4">
            <div class="col-lg-4 col-md-6">
                {{ form_row(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Nom du menu'}}) }}
            </div>

            <div class="col-lg-4 col-md-6">
                {{ form_row(form.price, {'attr': {'class': 'form-control', 'placeholder': 'Prix'}}) }}
            </div>
            <div class="col-lg-4 col-md-6">
                {{ form_row(form.category, {'attr': {'class': 'form-control', 'placeholder': 'Catégorie'}}) }}
            </div>

            <div class="col-lg-4 col-md-6">
                {{ form_row(form.image, {'attr': {'class': 'form-control', 'placeholder': 'URL de l\'image'}}) }}
            </div>
            <div class="col-lg-4 col-md-6 d-flex align-items-center">
                {{ form_row(form.available, {'attr': {'class': 'form-check-input'}}) }}
             </div>
            <div class="col-lg-4 col-md-6">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Description'}}) }}
            </div>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary px-4">Ajouter</button>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
